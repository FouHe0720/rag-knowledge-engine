# Offline defaults: no key, no network, no model download.
RAG_DB=data/index.sqlite3
RAG_CORPUS_ROOT=corpus
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_DIMENSION=128
RAG_ANSWER_PROVIDER=extractive
RAG_TOP_N=20
RAG_RRF_K=60
RAG_EVIDENCE_THRESHOLD=0.25
RAG_MAX_DOCUMENT_BYTES=5000000
RAG_REQUEST_TIMEOUT=20

# Real compatible API: use a NEW DB. Both adapters use this base URL.
# RAG_EMBEDDING_PROVIDER=compatible
# RAG_API_BASE_URL=https://api.example.com/v1
# RAG_API_KEY=
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_REVISION=your-deployment-or-snapshot-id
# RAG_EMBEDDING_DIMENSION=384
# RAG_ANSWER_PROVIDER=compatible
# RAG_LLM_MODEL=your-chat-model
# RAG_DB=data/real-index.sqlite3

# Optional CPU sentence-transformers: install .[cpu] explicitly first.
# RAG_EMBEDDING_PROVIDER=sentence_transformers
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_EMBEDDING_REVISION=<immutable-Hugging-Face-commit>
# RAG_EMBEDDING_DIMENSION=384
# RAG_ALLOW_MODEL_DOWNLOAD=false
# RAG_MODEL_CACHE=models
